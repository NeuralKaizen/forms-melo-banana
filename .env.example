# === Required on Vercel (Project → Settings → Environment Variables) ===
DATABASE_URL=postgres://...neon...   # Neon Postgres connection string
OPENROUTER_API_KEY=sk-or-...         # brief generator (Claude via OpenRouter)
ADMIN_PASSWORD=changeme              # gate for /admin
MCP_PUBLIC_URL=https://tu-dominio.example.com  # URL pública del servidor MCP, sin barra final — la usan los documentos de descubrimiento OAuth en /.well-known/*

# === Local only — used by `npm run gen:audio` (not needed on Vercel) ===
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# === Local only — used by `npm run upload:dropbox` ===
# Pedirle a Mellow & Banana las 3 de abajo (app key/secret del App Console + refresh token).
# El refresh token no expira; el script saca un access token fresco en cada corrida.
DROPBOX_APP_KEY=...
DROPBOX_APP_SECRET=...
DROPBOX_REFRESH_TOKEN=...
# Alternativa sólo para probar: token del App Console, expira a las ~4 h.
# Si están las 3 de arriba, esta se ignora.
DROPBOX_ACCESS_TOKEN=...
# Carpeta destino dentro del Dropbox de ellos, con / inicial.
DROPBOX_DEST_FOLDER=/Entregables/Lucianos

# === Local only — used by `npm run upload:drive` ===
# OJO: una API key de Google NO sirve acá — Drive exige OAuth para escribir.
# 1. En TU Google Cloud Console: habilitar Drive API y crear OAuth client ID tipo "Desktop app".
# 2. Pedirle al cliente que comparta la carpeta destino con tu cuenta como Editor.
# 3. Correr `npm run auth:drive` una vez para generar el refresh token.
GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=...
GOOGLE_OAUTH_REFRESH_TOKEN=...
# ID de la carpeta destino (lo que va después de /folders/ en la URL).
GOOGLE_DRIVE_FOLDER_ID=17Uhwrwlf12QtEGaHf0Tx--Wcjnbsqjbl
